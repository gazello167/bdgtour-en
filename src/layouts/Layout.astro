    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Travellian</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
   	<script>
 	    import { initSliders } from "src/scripts/slider";
