---
// Galeri dari folder images/testimonials di server (dikelola lewat CMS PHP).
const base = import.meta.env.BASE_URL;
---

<section class="ht" data-home-gallery="testimonials" data-dir={`${base}images/testimonials/`} hidden aria-labelledby="testi-title">
  <div class="wrap">
    <header class="head">
      <h2 id="testi-title">What our guests say</h2>
      <div class="nav">
        <button class="go go-prev" type="button" aria-label="Previous testimonials" disabled>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button class="go go-next" type="button" aria-label="Next testimonials">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </header>
    <ul class="track" tabindex="0" aria-label="Guest testimonials"></ul>
  </div>
</section>

<style>
  .ht { --ink: var(--bt-ink, #18222f); --accent: var(--bt-accent, #ff7757); --gap: 1rem; padding: 5rem 1.25rem; background: #f6f8f9; }
  .ht[hidden] { display: none; }
  .wrap { max-width: 1120px; margin: 0 auto; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  h2 { margin: 0; font-size: clamp(1.7rem, 3.5vw, 2.4rem); font-weight: 500; line-height: 1.2; color: var(--ink); }
  .nav { display: flex; gap: 0.5rem; }
  .go { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; padding: 0; border: 1px solid #d5dce2; border-radius: 50%; background: #fff; color: var(--ink); cursor: pointer; }
  .go:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .go:disabled { opacity: 0.35; cursor: default; }
  .go:focus-visible, .track:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  .track { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .track::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: no-preference) { .track { scroll-behavior: smooth; } }
  .track :global(li) { flex: 0 0 86%; scroll-snap-align: start; min-width: 0; background: #fff; border-radius: 1rem; overflow: hidden; box-shadow: 0 1px 3px rgba(24, 34, 47, 0.08); }
  @media (min-width: 700px) { .track :global(li) { flex-basis: calc((100% - var(--gap)) / 2); } }
  @media (min-width: 1000px) { .track :global(li) { flex-basis: calc((100% - 2 * var(--gap)) / 3); } }
  .track :global(img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: #e8edf0; }
  .track :global(p) { margin: 0; padding: 1rem 1.1rem 1.2rem; line-height: 1.55; color: var(--ink); white-space: pre-line; }
</style>

<script>
  import { loadGallery } from "../../scripts/home-gallery";

  document.querySelectorAll<HTMLElement>('[data-home-gallery="testimonials"]').forEach(async (root) => {
    const dir = root.dataset.dir!;
    const items = await loadGallery(dir, 12);
    if (!items.length) return;
    const track = root.querySelector<HTMLElement>(".track")!;
    for (const it of items) {
      const li = document.createElement("li");
      const img = document.createElement("img");
      img.src = dir + encodeURIComponent(it.file);
      img.alt = it.alt;
      img.loading = "lazy";
      img.decoding = "async";
      li.append(img);
      if (it.caption) {
        const p = document.createElement("p");
        p.textContent = it.caption;
        li.append(p);
      }
      track.append(li);
    }
    root.hidden = false;

    const prev = root.querySelector<HTMLButtonElement>(".go-prev")!;
    const next = root.querySelector<HTMLButtonElement>(".go-next")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const step = () => (slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth);
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
    next.addEventListener("click", () => track.scrollBy({ left: step() }));
    track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>
