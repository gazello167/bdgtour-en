---
import Section from "@components/sections/Section.astro";
import OfferCard from "@components/blocks/OfferCard.astro";
import SliderArrows from "@components/blocks/SliderArrows.astro";
import Heading from "@components/ui/Heading.astro";

import data from "@data/special-offer.json"; // hanya untuk judul dan subjudul
import { getAllPosts, postUrl } from "../../lib/posts";

// Artikel kategori Itineraries yang dicentang "Featured" di CMS PHP (butuh gambar utama), paket terpendek dulu.
const posts = (await getAllPosts())
  .filter((p) => p.category === "itineraries" && p.featured && p.image_url)
  .sort((a, b) => (a.days ?? 99) - (b.days ?? 99))
  .slice(0, 8);

const short = (s: string | null, max = 150) => {
  const t = (s ?? "").replace(/\s+/g, " ").trim();
  return t.length <= max ? t : t.slice(0, max).replace(/\s+\S*$/, "") + "...";
};
---

{posts.length > 0 && (
  <Section>
    <div class="offer-slider">
      <div class="splide splide--grid inverted">
        <div class="splide__text">
          <Heading level="h2" decor textAlign="right">{data.title}</Heading>
          <p>{data.subtitle}</p>
        </div>

        <SliderArrows />

        <div class="splide__track">
          <div class="splide__list">
            {posts.map((p) => (
              <div class="splide__slide">
                <OfferCard
                  title={p.title}
                  text={short(p.excerpt)}
                  image={p.image_url!}
                  href={postUrl(p)}
                  meta={p.days ? `${p.days} ${p.days === 1 ? "day" : "days"}` : "Itinerary"}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>
)}
