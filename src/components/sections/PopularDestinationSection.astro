---
import Section from "@components/sections/Section.astro";
import TravelCard from "@components/blocks/TravelCard.astro";
import SliderArrows from "@components/blocks/SliderArrows.astro";
import Heading from "@components/ui/Heading.astro";

import data from "@data/popular-destinations.json";
---

<Section>
  <div class="popular-slider">
    <div class="splide splide--grid">
      <div class="splide__text">
        <Heading level="h2" decor>{data.title}</Heading>
        <p>{data.subtitle}</p>
      </div>

      <SliderArrows />

      <div class="splide__track">
        <div class="splide__list">
          {
            data.slider.map(item => (
              <div class="splide__slide">
                <TravelCard
                  title={item.title}
                  location={item.location}
                  image={item.image}
              />
            </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Section>
