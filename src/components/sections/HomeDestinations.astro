---
import Section from "@components/sections/Section.astro";
import SliderArrows from "@components/blocks/SliderArrows.astro";
import DestinationCard from "@components/blocks/DestinationCard.astro";
import Heading from "@components/ui/Heading.astro";

import data from "@data/destination-gallery.json"; // hanya untuk judul dan subjudul
import { getDestinationImages } from "../../lib/home-cms";

// Foto dari folder images/destinations (dikelola di CMS PHP). Klik foto membuka lightbox.
const items = await getDestinationImages();
const lightboxData = JSON.stringify(items.map((i) => ({ src: i.src, alt: i.alt }))).replace(/</g, "\\u003c");
---

{items.length > 0 && (
  <Section>
    <div class="destination-slider" data-lightbox-images={lightboxData}>
      <div class="splide splide--grid">
        <div class="splide__text">
          <Heading level="h2" decor>{data.title}</Heading>
          <p>{data.subtitle}</p>
        </div>

        <SliderArrows />

        <div class="splide__track splide__track--overfloved">
          <div class="splide__list">
            {items.map((item) => (
              <div class="splide__slide">
                {/* href = file foto, jadi tanpa JavaScript foto tetap bisa dibuka */}
                <DestinationCard image={item.src} alt={item.alt} href={item.src} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <dialog class="dest-lightbox" aria-label="Photo viewer">
        <button class="lb-btn lb-close" type="button" aria-label="Close photo viewer">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
        <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button class="lb-btn lb-next" type="button" aria-label="Next photo">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
        <figure>
          <img alt="" />
          <figcaption></figcaption>
        </figure>
        <p class="lb-count" aria-live="polite"></p>
      </dialog>
    </div>
  </Section>
)}

<style>
  .destination-slider {
    overflow: hidden;
  }

  .destination-slider :global(.card--destination .card__link) {
    cursor: zoom-in;
  }

  /* ---- Lightbox ---- */
  .dest-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 16, 24, 0.94);
    color: #fff;
  }
  .dest-lightbox[open] { display: grid; place-items: center; }
  .dest-lightbox::backdrop { background: rgba(10, 16, 24, 0.94); }
  .dest-lightbox figure { margin: 0; max-width: min(92vw, 1200px); display: grid; gap: 1.2rem; justify-items: center; }
  .dest-lightbox img { display: block; max-width: 100%; max-height: 80vh; width: auto; height: auto; border-radius: 0.8rem; }
  .dest-lightbox figcaption { text-align: center; max-width: 60rem; font-size: 1.6rem; line-height: 1.5; }
  .dest-lightbox figcaption:empty { display: none; }
  .lb-count { position: absolute; top: 2rem; left: 2rem; margin: 0; font-size: 1.5rem; color: #aab4bf; }
  .lb-btn {
    position: absolute; display: grid; place-items: center; width: 4.8rem; height: 4.8rem; padding: 0;
    border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.14); color: #fff; cursor: pointer;
  }
  .lb-btn:hover { background: rgba(255, 255, 255, 0.28); }
  .lb-btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .lb-close { top: 1.6rem; right: 1.6rem; }
  .lb-prev { left: 1.6rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1.6rem; top: 50%; transform: translateY(-50%); }
  .dest-lightbox[data-single] .lb-prev,
  .dest-lightbox[data-single] .lb-next,
  .dest-lightbox[data-single] .lb-count { display: none; }
  @media (max-width: 640px) {
    .lb-prev, .lb-next { top: auto; bottom: 1.6rem; transform: none; }
    .dest-lightbox img { max-height: 70vh; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".destination-slider[data-lightbox-images]").forEach((root) => {
    let list: { src: string; alt: string }[] = [];
    try { list = JSON.parse(root.dataset.lightboxImages ?? "[]"); } catch { return; }
    const dlg = root.querySelector<HTMLDialogElement>("dialog.dest-lightbox");
    if (!dlg || !list.length) return;

    const img = dlg.querySelector<HTMLImageElement>("figure img")!;
    const cap = dlg.querySelector<HTMLElement>("figcaption")!;
    const count = dlg.querySelector<HTMLElement>(".lb-count")!;
    if (list.length === 1) dlg.setAttribute("data-single", "");

    const fileOf = (u: string) => decodeURIComponent(u.split("?")[0].split("/").pop() ?? "");
    const files = list.map((i) => fileOf(i.src));

    let index = 0;
    const show = (n: number) => {
      index = (n + list.length) % list.length;
      img.src = list[index].src;
      img.alt = list[index].alt;
      cap.textContent = list[index].alt;
      count.textContent = `${index + 1} / ${list.length}`;
      [index + 1, index - 1].forEach((m) => { new Image().src = list[(m + list.length) % list.length].src; });
    };

    // Delegasi klik: slide hasil kloning Splide (mode loop) tidak membawa event listener sendiri.
    root.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(".card--destination a");
      if (!a || e.defaultPrevented) return;          // defaultPrevented = baru selesai menggeser slider
      const thumb = a.querySelector("img");
      const at = thumb ? files.indexOf(fileOf(thumb.currentSrc || thumb.src)) : -1;
      if (at < 0) return;
      e.preventDefault();
      show(at);
      dlg.showModal();
      document.body.style.overflow = "hidden";
    });

    dlg.querySelector(".lb-prev")?.addEventListener("click", () => show(index - 1));
    dlg.querySelector(".lb-next")?.addEventListener("click", () => show(index + 1));
    dlg.querySelector(".lb-close")?.addEventListener("click", () => dlg.close());
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
    dlg.addEventListener("close", () => { document.body.style.overflow = ""; });
  });
</script>
