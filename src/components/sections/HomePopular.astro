---
import Section from "@components/sections/Section.astro";
import TravelCard from "@components/blocks/TravelCard.astro";
import SliderArrows from "@components/blocks/SliderArrows.astro";
import Heading from "@components/ui/Heading.astro";

import data from "@data/popular-destinations.json"; // hanya untuk judul dan subjudul
import { getAllPosts, postUrl, DESTINATIONS } from "../../lib/posts";

// Artikel kategori Destinations yang dicentang "Popular" di CMS PHP (butuh gambar utama).
const posts = (await getAllPosts())
  .filter((p) => p.category === "destinations" && p.popular && p.image_url)
  .slice(0, 8); // getAllPosts sudah urut terbaru dulu
---

{posts.length > 0 && (
  <Section>
    <div class="popular-slider">
      <div class="splide splide--grid">
        <div class="splide__text">
          <Heading level="h2" decor>{data.title}</Heading>
          <p>{data.subtitle}</p>
        </div>

        <SliderArrows />

        <div class="splide__track">
          <div class="splide__list">
            {posts.map((p) => (
              <div class="splide__slide">
                <TravelCard
                  title={p.title}
                  location={p.destination ? DESTINATIONS[p.destination].label : "Bandung"}
                  image={p.image_url!}
                  href={postUrl(p)}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>
)}
