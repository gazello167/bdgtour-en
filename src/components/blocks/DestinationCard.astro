---
import { Image } from "astro:assets";

interface Props {
  image: string;
  alt?: string;
  href?: string;
}

const { image, alt = "Travel Destination", href = "#" } = Astro.props;
---

<article class="card card--destination">
  <a href={href} class="card__link">
    <Image
      src={image}
      width={400}
      height={600}
      class="card__image"
      alt={alt}
      loading="lazy"
    />
  </a>
</article>
