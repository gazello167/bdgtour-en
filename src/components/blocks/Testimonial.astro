---
import Rating from "@components/ui/Rating.astro";
import { Image } from "astro:assets";

interface Props {
  name: string;
  position: string;
  image: string;
  rating: number;
  text: string;
}

const {name, position, image, rating, text} = Astro.props;
---
<div class="testimonial">
  <span class="testimonial_avatar">
    <Image
      src={image}
      alt=`{name} photo`
      width={100}
      height={100}
    />
  </span>
  <p class="testimonial__text">{text}</p>
  <Rating stars={rating} />
  <div class="testimonial__author">
    <span class="name">{name}</span>
    <span class="position">{position}</span>
  </div>
</div>

<style is:global>
@layer components {
  .testimonial {
    position: relative;
    display: flex;
    margin-top: 6rem;
    padding: 6rem 4rem 4rem;
    flex-direction: column;
    gap: 2rem;
    border-radius: 1.2rem;
    background-color: #F5F6F7;

    @media screen and (max-width: 767px) {
      padding: 6rem 2rem 3.2rem;
    }
  }

  .testimonial_avatar {
    display: block;
    margin: -12rem 0 0.5rem;
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .testimonial__text {
    color: var(--secondary-color);
    line-height: 1.33;
  }

  .testimonial__author {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    .name {
      font-size: 2.4rem;
      font-family: var(--heading-font);
    }

    .position {
      font-size: 1.8rem;
    }
  }
}
</style>
