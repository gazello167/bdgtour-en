---
import type { GalleryImage } from "../../lib/posts";

interface Props {
  images: GalleryImage[];
  heading?: string;
}

const { images, heading = "Photo gallery" } = Astro.props;
const n = images.length;
---

{n > 0 && (
  <section class="gallery" aria-label={heading} data-gallery>
    <h2 class="sr-only">{heading}</h2>

    <div class="slider">
      <ul class="track" tabindex="0" aria-label={`${heading}, ${n} ${n === 1 ? "photo" : "photos"}`}>
        {images.map((img, i) => (
          <li class="slide">
            <a
              href={img.url}
              data-alt={img.alt}
              data-caption={img.caption ?? ""}
              data-credit={img.credit ?? ""}
              aria-label={`Open photo ${i + 1} of ${n} in full screen`}
            >
              <img src={img.url} alt={img.alt} loading="lazy" decoding="async" draggable="false" />
            </a>
            {img.caption && img.caption !== img.alt && <p class="slide-cap">{img.caption}</p>}
          </li>
        ))}
      </ul>

      {n > 1 && (
        <div class="bar">
          <p class="pos" aria-live="polite">1 / {n}</p>
          <div class="nav">
            <button class="go go-prev" type="button" aria-label="Previous photos" disabled>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button class="go go-next" type="button" aria-label="Next photos">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
        </div>
      )}
    </div>

    <dialog class="lightbox" aria-label="Photo viewer">
      <button class="btn close" type="button" aria-label="Close photo viewer">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <button class="btn prev" type="button" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button class="btn next" type="button" aria-label="Next photo">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
      <figure>
        <img alt="" />
        <figcaption>
          <span class="cap"></span>
          <span class="credit"></span>
        </figcaption>
      </figure>
      <p class="count" aria-live="polite"></p>
    </dialog>
  </section>
)}

<style>
  .gallery {
    --accent: var(--bt-accent, #ff7757);
    --ink: var(--bt-ink, #18222f);
    --muted: var(--bt-muted, #5d6874);
    --gap: 0.75rem;
    margin: -1.25rem 0 3rem;
  }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* ---- Slider: semua foto adalah <img> biasa di HTML, jadi terbaca Google Images ---- */
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 0.5rem; }

  .slide { flex: 0 0 86%; scroll-snap-align: start; min-width: 0; }
  .slide a { display: block; border-radius: 0.9rem; overflow: hidden; background: #e8edf0; aspect-ratio: 4 / 3; }
  .slide img { display: block; width: 100%; height: 100%; object-fit: cover; user-select: none; }
  @media (prefers-reduced-motion: no-preference) {
    .slide img { transition: transform 0.35s ease; }
    .slide a:hover img { transform: scale(1.03); }
    .track { scroll-behavior: smooth; }
  }
  .slide-cap { margin: 0.5rem 0 0; font-size: 0.9rem; line-height: 1.45; color: var(--muted); }
  .slide a:focus-visible, .go:focus-visible, .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  .bar { display: flex; align-items: center; justify-content: space-between; margin-top: 0.75rem; }
  .pos { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .nav { display: flex; gap: 0.5rem; }
  .go {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem; padding: 0;
    border: 1px solid #d5dce2; border-radius: 50%; background: #fff; color: var(--ink); cursor: pointer;
  }
  .go:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .go:disabled { opacity: 0.35; cursor: default; }

  @media (min-width: 700px) {
    .slide { flex-basis: calc((100% - var(--gap)) / 2); }
  }
  @media (min-width: 1000px) {
    .slide { flex-basis: calc((100% - 2 * var(--gap)) / 3); }
  }

  /* ---- Lightbox ---- */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 16, 24, 0.94);
    color: #fff;
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgba(10, 16, 24, 0.94); }
  figure { margin: 0; max-width: min(92vw, 1200px); display: grid; gap: 0.75rem; justify-items: center; }
  figure img { display: block; max-width: 100%; max-height: 78vh; width: auto; height: auto; border-radius: 0.5rem; }
  figcaption { text-align: center; max-width: 42rem; line-height: 1.5; }
  .cap { display: block; font-size: 1rem; }
  .credit { display: block; font-size: 0.85rem; color: #aab4bf; }
  .cap:empty, .credit:empty { display: none; }
  .count { position: absolute; top: 1.25rem; left: 1.25rem; margin: 0; font-size: 0.9rem; color: #aab4bf; }

  .btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
  }
  .btn:hover { background: rgba(255, 255, 255, 0.24); }
  .close { top: 1rem; right: 1rem; }
  .prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .lightbox[data-single] .prev, .lightbox[data-single] .next, .lightbox[data-single] .count { display: none; }

  @media (max-width: 640px) {
    .prev, .next { top: auto; bottom: 1rem; transform: none; }
    .prev { left: 1rem; }
    .next { right: 1rem; }
    figure img { max-height: 68vh; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".track");
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".slide"));
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>("a[data-alt]"));
    const dlg = root.querySelector<HTMLDialogElement>("dialog");
    if (!track || !dlg || links.length === 0) return;

    // ---------- slider ----------
    const prevBtn = root.querySelector<HTMLButtonElement>(".go-prev");
    const nextBtn = root.querySelector<HTMLButtonElement>(".go-next");
    const pos = root.querySelector<HTMLElement>(".pos");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const step = () => (slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth);

    const update = () => {
      if (!pos) return;
      const s = step() || 1;
      const visible = Math.max(1, Math.floor((track.clientWidth + 0.1 * s) / s + 0.05));
      const atStart = track.scrollLeft <= 2;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      let first = atEnd ? slides.length - visible : Math.round(track.scrollLeft / s);
      first = Math.max(0, Math.min(first, slides.length - 1));
      const last = Math.min(slides.length, first + visible);
      pos.textContent = visible > 1 ? `${first + 1}\u2013${last} / ${slides.length}` : `${first + 1} / ${slides.length}`;
      if (prevBtn) prevBtn.disabled = atStart;
      if (nextBtn) nextBtn.disabled = atEnd;
    };
    const go = (dir: number) => track.scrollBy({ left: dir * step(), behavior: reduce ? "auto" : "smooth" });
    prevBtn?.addEventListener("click", () => go(-1));
    nextBtn?.addEventListener("click", () => go(1));
    track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    window.addEventListener("resize", update);
    update();

    // ---------- lightbox ----------
    const img = dlg.querySelector<HTMLImageElement>("figure img")!;
    const cap = dlg.querySelector<HTMLElement>(".cap")!;
    const credit = dlg.querySelector<HTMLElement>(".credit")!;
    const count = dlg.querySelector<HTMLElement>(".count")!;
    if (links.length === 1) dlg.setAttribute("data-single", "");

    let index = 0;
    const show = (n: number) => {
      index = (n + links.length) % links.length;
      const a = links[index];
      img.src = a.href;
      img.alt = a.dataset.alt ?? "";
      cap.textContent = a.dataset.caption ?? "";
      credit.textContent = a.dataset.credit ? `Photo: ${a.dataset.credit}` : "";
      count.textContent = `${index + 1} / ${links.length}`;
      [index + 1, index - 1].forEach((m) => {
        const pre = new Image();
        pre.src = links[(m + links.length) % links.length].href;
      });
    };

    links.forEach((a, n) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        show(n);
        dlg.showModal();
        document.body.style.overflow = "hidden";
      });
    });

    dlg.querySelector(".prev")?.addEventListener("click", () => show(index - 1));
    dlg.querySelector(".next")?.addEventListener("click", () => show(index + 1));
    dlg.querySelector(".close")?.addEventListener("click", () => dlg.close());
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
    dlg.addEventListener("close", () => {
      document.body.style.overflow = "";
      // geser slider ke foto terakhir yang dilihat di lightbox
      slides[index]?.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "auto" });
    });
  });
</script>
