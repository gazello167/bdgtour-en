---
import Logo from "@components/ui/Logo.astro";
import Link from "@components/ui/Link.astro";
import Burger from "@components/ui/Burger.astro"

import data from "@data/header.json";

interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
---
<header class:list={["header", { "header--dark": theme === "dark" }]} id="header">
  <div class="header__inner">
    <span class="header__logo">
      <Logo type="full" />
    </span>

    <div class="main-menu">
      <nav class="header__nav">
        <ul class="header__nav-list">
          {
            data.menu.map(item => (
              <li class="header__nav-item">
                <Link
                  className={"header__nav-link"}
                  href={item.url}
                  text={item.text}
                />
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="account">
        {
          data.account.map(item => {
            const buttonProps = item.isButton
            ? {
                className: "",
                color: "tertiary",
                isButton: true
              }
            : {
                className: "header__nav-link"
            };
            return (
              <Link
                href={item.url}
                text={item.text}
                {...buttonProps}
              />
            );
          })
        }
      </nav>
    </div>

    <Burger />

  </div>
</header>

<style is:global>
  /* Tema gelap: dipakai di halaman berlatar putih (blog, artikel, dll). */
  .header.header--dark .header__nav-link,
  .header.header--dark .header__nav-link:visited {
    color: #18222f;
  }
  .header.header--dark .header__nav-link:hover {
    color: #ff7757;
  }

  /* Logo & hamburger: jadikan hitam tanpa perlu file baru.
     Kalau nanti logo diganti PNG berwarna, hapus aturan .header__logo
     di bawah ini supaya warna aslinya tidak ikut menghitam. 
  .header.header--dark .header__logo {
    filter: brightness(0);
  } */
  .header.header--dark [class*="burger"] {
    filter: brightness(0);
  }
</style>

<script>
const header = document.getElementById("header");

if (header) {
  const onScroll = () => {
    header.classList.toggle("header--scrolled", window.scrollY > 0);
  };

  onScroll();

  window.addEventListener("scroll", onScroll, { passive: true });
}
</script>
