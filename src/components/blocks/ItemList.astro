---
import type { Item } from "../../lib/posts";

interface Props {
  items: Item[];
  heading?: string;
}

const { items, heading = "Recommended places" } = Astro.props;

const mapLink = (it: Item) =>
  it.map_url ||
  (it.address
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${it.name} ${it.address}`)}`
    : "");
---

{items.length > 0 && (
  <section class="items" aria-label={heading}>
    <h2>{heading}</h2>
    <ul>
      {items.map((it) => (
        <li>
          <div class="top">
            <h3>{it.name}</h3>
            {it.price && <span class="price">{it.price}</span>}
          </div>
          {it.note && <p class="note">{it.note}</p>}
          {it.address && <p class="addr">{it.address}</p>}
          {mapLink(it) && (
            <a class="map" href={mapLink(it)} target="_blank" rel="noopener noreferrer">View on map</a>
          )}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .items {
    --accent: var(--bt-accent, #ff7757);
    --ink: var(--bt-ink, #18222f);
    --muted: var(--bt-muted, #5d6874);
    max-width: 42rem;
    margin: 2.5rem auto 0;
  }
  h2 { font-size: 1.7rem; font-weight: 500; line-height: 1.25; color: var(--ink); margin: 0 0 1.25rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  li { padding: 1.25rem 1.5rem; border: 1px solid #e3e8ec; border-radius: 1rem; }
  .top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.25rem 1rem; }
  h3 { font-size: 1.2rem; font-weight: 500; color: var(--ink); margin: 0; }
  .price { font-size: 0.9rem; font-weight: 500; color: var(--ink); background: #f3f6f7; padding: 0.15rem 0.7rem; border-radius: 999px; }
  .note { line-height: 1.6; color: #2b3644; margin: 0.6rem 0 0; }
  .addr { font-size: 0.9rem; color: var(--muted); margin: 0.6rem 0 0; }
  .map { display: inline-block; margin-top: 0.6rem; font-size: 0.9rem; font-weight: 500; color: var(--accent); text-underline-offset: 3px; }
  .map:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 0.3rem; }
</style>
