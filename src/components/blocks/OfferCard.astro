---
import Link from "@components/ui/Link.astro";
import Rating from "@components/ui/Rating.astro";
import Heading from "@components/ui/Heading.astro";
import { Image } from "astro:assets";

interface Props {
	title: string;
	text: string;
	image: string;
	rating?: number;   // kosong = bintang tidak ditampilkan
	price?: number;    // kosong = tampilkan `meta` (mis. "2 days")
	meta?: string;
	href?: string;     // tautan ke artikel (default "#", buka tab baru seperti semula)
}

const { title, image, text, rating, price, meta, href } = Astro.props;
---

<article class="card card--offer">
	<Image
		src={image}
		class="card__image"
		alt=`Special offer image - ${title}`
		width={500}
		height={300}
		loading="lazy"
	/>

	<div class="card__content">
		<div class="card__heading-holder">
			<Heading level="h4">{title}</Heading>
			{rating ? <Rating stars={rating} /> : null}
		</div>

		<div class="card__description">{text}</div>

		<div class="card__links">
			<span class="card__price">
				{price !== undefined ? <>From <strong>€{price}</strong></> : <strong>{meta}</strong>}
			</span>
			<Link
				href={href ?? "#"}
				text="Details"
				color="tertiary"
				isButton={true}
				target={href ? undefined : "_blank"}
				rel={href ? undefined : "noopener noreferrer"}
			/>
		</div>
	</div>
</article>
