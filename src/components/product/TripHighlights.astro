---
import type { Fleet } from "../../lib/product";
interface Props { highlights: string[]; fleet: Fleet[]; note?: string; }
const { highlights, fleet, note } = Astro.props;
---
{(highlights.length > 0 || fleet.length > 0) && (
  <section class="hl" aria-labelledby="hl-h">
    <h2 id="hl-h">Trip benefits</h2>
    {highlights.length > 0 && <ul class="list">{highlights.map((h) => <li>{h}</li>)}</ul>}
    {fleet.length > 0 && (
      <>
        <h3>Vehicle by group size</h3>
        <div class="fleet">
          {fleet.map((f) => <div><strong>{f.name}</strong><span>{f.seats}</span></div>)}
        </div>
      </>
    )}
    {note && <p class="note">{note}</p>}
  </section>
)}
<style>
  .hl { margin-bottom: 48px; }
  h2 { font-size: 27.2px !important; font-weight: 500; color: var(--ink); margin: 0 0 20px; }
  h3 { font-size: 16.8px !important; font-weight: 600; margin: 24px 0 12px; color: var(--ink); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 9.6px; }
  .list li { position: relative; padding-left: 27.2px; line-height: 1.55; color: #2b3644; }
  .list li::before { content: "★"; position: absolute; left: 0; color: var(--accent); }
  .fleet { display: grid; grid-template-columns: repeat(auto-fit, minmax(144px, 1fr)); gap: 12px; }
  .fleet div { display: grid; gap: 2.4px; padding: 13.6px 16px; border-radius: 12.8px; background: #f6f8f9; border: 1px solid #e3e8ec; }
  .fleet span { color: var(--muted); font-size: 14.4px; }
  .note { margin: 24px 0 0; padding: 16px 20px; border-left: 4px solid var(--accent); background: #fff8f5; border-radius: 0 12.8px 12.8px 0; line-height: 1.6; color: #2b3644; }
</style>
