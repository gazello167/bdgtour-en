---
import { rp, priceRange, type PriceTable } from "../../lib/product";
interface Props { table: PriceTable; }
const { table } = Astro.props;
const hasPickup = table.rows.some((r) => r.pickup);
const best = priceRange({ price_table: table } as any)?.low;
const pickupLabel = table.pickup_label || "Extra per person for pickup outside Bandung";
---
<section id="prices" class="prices" aria-labelledby="pr-h">
  <h2 id="pr-h">Prices</h2>
  <p class="sub">
    Price per person in Indonesian rupiah{table.hotel ? `, with hotel: ${table.hotel}` : ""}. The bigger vehicle is not always cheaper per person, so ask us about the best fit for your group.
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Group size</th>
          <th scope="col">Vehicle (seats)</th>
          <th scope="col">Price per person</th>
          {hasPickup && <th scope="col">{pickupLabel}</th>}
        </tr>
      </thead>
      <tbody>
        {table.rows.map((r) => (
          <tr class:list={{ best: best === r }}>
            <th scope="row" data-l="Group size">{r.pax} {r.pax === "1" ? "traveller" : "travellers"}</th>
            <td data-l="Vehicle">{r.vehicle}</td>
            <td data-l="Per person"><span class="pp"><strong>{rp(r.price)}</strong>{best === r && <em>Lowest price</em>}</span></td>
            {hasPickup && <td data-l="Pickup extra">{r.pickup ? `+ ${rp(r.pickup)}` : "–"}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {table.notes.length > 0 && <ul class="notes">{table.notes.map((n) => <li>{n}</li>)}</ul>}
</section>
<style>
  .prices { scroll-margin-top: 96px; margin-bottom: 48px; }
  h2 { font-size: 27.2px !important; font-weight: 500; color: var(--ink); margin: 0 0 8px; }
  .sub { color: var(--muted); margin: 0 0 20px; line-height: 1.6; }
  .scroll { border: 1px solid #e3e8ec; border-radius: 16px; overflow: hidden; background: #fff; }
  table { width: 100%; border-collapse: collapse; font-size: 15.7px; }
  th, td { padding: 13.6px 16px; text-align: left; border-bottom: 1px solid #edf1f3; }
  thead th { background: var(--ink); color: #fff; font-weight: 500; font-size: 14.1px; }
  tbody tr:last-child > * { border-bottom: 0; }
  tbody th { font-weight: 500; white-space: nowrap; }
  tbody tr:nth-child(even) { background: #fafbfc; }
  tr.best { background: #fff3ef !important; }
  .pp { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 0; }
  td strong { font-weight: 600; }
  td em { font-style: normal; margin-left: 8px; font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; background: var(--accent); color: #fff; padding: 2.4px 8px; border-radius: 999px; white-space: nowrap; }
  .notes { margin: 16px 0 0; padding-left: 19.2px; color: var(--muted); font-size: 14.7px; line-height: 1.6; }
  @media (max-width: 640px) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    table, tbody, tr, th, td { display: block; }
    .scroll { border: 0; background: none; overflow: visible; }
    tbody { display: grid; gap: 12px; }
    tbody tr, tbody tr:nth-child(even) { background: #fff; border: 1px solid #e3e8ec; border-radius: 14.4px; padding: 8px 0; }
    tr.best { border-color: var(--accent); }
    .pp { justify-content: flex-end; }
    tbody th { white-space: normal; }
    th, td { border: 0 !important; display: flex; justify-content: space-between; gap: 16px; padding: 6.4px 16px; }
    td::before, tbody th::before { content: attr(data-l); color: var(--muted); font-size: 13.6px; font-weight: 400; }
    td:last-child { padding-bottom: 8px; }
  }
</style>
