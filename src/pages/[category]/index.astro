---
import Layout from "@layouts/Layout.astro";
import PostGrid from "../../components/blocks/PostGrid.astro";
import images from "@data/destination-images.json";
import {
  getAllPosts,
  CATEGORIES,
  DESTINATIONS,
  isDestinationGuide,
  destinationUrl,
  type CategoryKey,
} from "../../lib/posts";

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const category = Astro.params.category as CategoryKey;
const meta = CATEGORIES[category];

const all = await getAllPosts();
let posts = all.filter((p) => p.category === category && !isDestinationGuide(p));
if (category === "itineraries") {
  posts = [...posts].sort((a, b) => (a.days ?? 99) - (b.days ?? 99));
}

// Halaman Destinations menampilkan kartu tujuh destinasi di atas daftar artikel
const destinationCards =
  category === "destinations"
    ? Object.entries(DESTINATIONS).map(([key, d]) => ({
        key,
        ...d,
        image: (images as Record<string, string>)[key],
        count: all.filter((p) => p.destination === key && !isDestinationGuide(p)).length,
      }))
    : [];
---

<Layout title={meta.label} description={meta.intro} headerTheme="dark">
  <main class="hub">
    <header class="head">
      <h1>{meta.label}</h1>
      <p>{meta.intro}</p>
    </header>

    {destinationCards.length > 0 && (
      <section class="dests" aria-label="Destinations">
        {destinationCards.map((d) => (
          <a class="dest" href={destinationUrl(d.key)}>
            {d.image && (
              <div class="dest-media">
                <img src={d.image} alt="" width="640" height="480" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="dest-body">
              <h2>{d.label}</h2>
              <p>{d.intro}</p>
              {d.count > 0 && <span>{d.count} {d.count === 1 ? "article" : "articles"}</span>}
            </div>
          </a>
        ))}
      </section>
    )}

    {posts.length > 0
      ? (
        <section class="posts" aria-labelledby="posts-title">
          <h2 id="posts-title" class="posts-title">All articles</h2>
          <PostGrid posts={posts} showCategory={false} />
        </section>
      )
      : destinationCards.length === 0 && <p class="empty">No articles in {meta.label} yet. New guides are on the way.</p>}
  </main>
</Layout>

<style>
  .hub {
    --accent: var(--bt-accent, #ff7757);
    --ink: var(--bt-ink, #18222f);
    --muted: var(--bt-muted, #5d6874);
    max-width: 1120px;
    margin: 0 auto;
    padding: 8rem 1.25rem 5rem;
    color: var(--ink);
  }
  .head { max-width: 40rem; margin-bottom: 3rem; }
  .head h1 { font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 500; line-height: 1.1; color: var(--ink); margin: 0 0 0.75rem; }
  .head p { font-size: 1.05rem; line-height: 1.6; color: var(--muted); margin: 0; }
  .empty { color: var(--muted); }

  .dests { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 3.5rem; }
  .dest { display: flex; flex-direction: column; overflow: hidden; border-radius: 1rem; background: #f3f6f7; color: inherit; text-decoration: none; }
  .dest-media { aspect-ratio: 4 / 3; overflow: hidden; background: #e3e9ec; }
  .dest-media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .dest:hover .dest-media img { transform: scale(1.04); }
  .dest-body { padding: 1.25rem 1.5rem 1.5rem; }
  .dest h2 { font-size: 1.4rem; font-weight: 500; color: var(--ink); margin: 0 0 0.5rem; }
  .dest p { line-height: 1.55; color: var(--muted); margin: 0 0 0.75rem; }
  .dest span { font-size: 0.9rem; font-weight: 500; color: var(--accent); }
  .dest:hover h2 { color: var(--accent); }
  .dest:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }

  .posts-title { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 500; line-height: 1.2; color: var(--ink); margin: 0 0 1.5rem; }

  @media (max-width: 800px) {
    .hub { padding-top: 6.5rem; }

    /* Mobile: kartu destinasi 2 kolom */
    .dests { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin-bottom: 2.5rem; }
    .dest-body { padding: 0.85rem 0.9rem 1rem; }
    .dest h2 { font-size: 1.05rem; margin-bottom: 0.35rem; }
    .dest p {
      font-size: 0.85rem; line-height: 1.45; margin-bottom: 0.5rem;
      display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .dest span { font-size: 0.8rem; }
  }
</style>