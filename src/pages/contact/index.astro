---
import Layout from "@layouts/Layout.astro";

const business = {
  name: "Fastrans Tour and Travel",
  logo: "https://cdn.bandung-tour.com/wp-content/uploads/2025/07/Logo-Fastrans-160x50-1.png",
  phoneDisplay: "+6281 1222 0194",
  phoneTel: "+6281112220194",
  whatsapp: "6281112220194",
  email: "fastrans.travel@gmail.com",
  address: "79B Lengkong Besar Street, Bandung, ID",
  mapsLink: "https://maps.app.goo.gl/pBu8GzvPDVrBue7g6",
};

const waText = encodeURIComponent("Hello Fastrans Tour and Travel, I would like to ask about a tour.");
const waUrl = `https://wa.me/${business.whatsapp}?text=${waText}`;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(`${business.name}, ${business.address}`)}&hl=en&z=16&output=embed`;
---

<Layout
  title="Contact"
  description={`Contact ${business.name} by phone, WhatsApp or email. Find our office at ${business.address}.`}
  headerTheme="dark"
>
  <main class="contact">
    <header class="head">
      <h1>Contact Us</h1>
      <p>Questions about a tour or a trip plan? Reach us by phone, WhatsApp or email.</p>
    </header>

    <div class="layout">
      <section class="info" aria-labelledby="contact-info">
        <img
          class="logo"
          src={business.logo}
          alt={business.name}
          width="160"
          height="50"
          decoding="async"
        />
        <h2 id="contact-info">{business.name}</h2>

        <ul class="list">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
            <a href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.2-8 5-8-5V6l8 5 8-5z"/></svg>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
            <address>{business.address}</address>
          </li>
        </ul>

        <div class="actions">
          <a class="btn btn-wa" href={waUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.5A9.9 9.9 0 1 0 12.04 2zm5.8 14.1c-.25.7-1.45 1.35-2 1.4-.5.05-1.15.07-1.85-.12a16 16 0 0 1-1.7-.63c-3-1.3-4.95-4.3-5.1-4.5-.15-.2-1.2-1.6-1.2-3.05s.75-2.15 1.02-2.45c.27-.3.6-.37.8-.37h.57c.18 0 .43-.07.67.5.25.6.85 2.07.92 2.22.08.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.32.38-.45.5-.15.15-.3.3-.13.6.17.3.77 1.27 1.65 2.05 1.12 1 2.07 1.3 2.37 1.45.3.15.47.12.65-.07.17-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.72.82 2.02.97.3.15.5.22.57.35.07.12.07.72-.18 1.42z"/></svg>
            WhatsApp
          </a>
          <a class="btn btn-call" href={`tel:${business.phoneTel}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
            Call
          </a>
        </div>
      </section>

      <section class="map" aria-label="Map">
        <iframe
          title={`Map of ${business.name}`}
          src={mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a class="map-link" href={business.mapsLink} target="_blank" rel="noopener noreferrer">
          Open in Google Maps
        </a>
      </section>
    </div>
  </main>
</Layout>

<style>
  .contact {
    --accent: var(--bt-accent, #ff7757);
    --ink: var(--bt-ink, #18222f);
    --muted: var(--bt-muted, #5d6874);
    max-width: 1120px;
    margin: 0 auto;
    padding: 8rem 1.25rem 5rem;
    color: var(--ink);
  }
  .head { max-width: 40rem; margin-bottom: 2.5rem; }
  .head h1 { font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 500; line-height: 1.1; color: var(--ink); margin: 0 0 0.75rem; }
  .head p { font-size: 1.05rem; line-height: 1.6; color: var(--muted); margin: 0; }

  .layout { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 1.5rem; align-items: stretch; }

  .info { background: #f3f6f7; border-radius: 1rem; padding: 2rem; display: flex; flex-direction: column; }
  .logo { display: block; width: 160px; height: auto; margin-bottom: 1.25rem; }
  .info h2 { font-size: 1.4rem; font-weight: 500; color: var(--ink); margin: 0 0 1.25rem; }

  .list { list-style: none; margin: 0 0 1.75rem; padding: 0; display: grid; gap: 1rem; }
  .list li { display: flex; gap: 0.75rem; align-items: flex-start; line-height: 1.5; }
  .list svg { flex: none; width: 1.25rem; height: 1.25rem; margin-top: 0.15rem; fill: var(--accent); }
  .list a { color: var(--ink); text-decoration: none; overflow-wrap: anywhere; }
  .list a:hover { color: var(--accent); }
  .list address { font-style: normal; color: var(--ink); }

  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: auto; }
  .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; border-radius: 999px; font-weight: 500; text-decoration: none; color: #fff; }
  .btn svg { width: 1.15rem; height: 1.15rem; fill: currentColor; }
  .btn-wa { background: #1fa855; }
  .btn-call { background: var(--ink); }
  .btn:hover { filter: brightness(1.08); }
  .btn:focus-visible, .map-link:focus-visible, .list a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  .map { position: relative; border-radius: 1rem; overflow: hidden; background: #e3e9ec; min-height: 360px; }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map-link { position: absolute; left: 0.75rem; bottom: 0.75rem; background: #fff; color: var(--ink); padding: 0.45rem 0.9rem; border-radius: 999px; font-size: 0.9rem; font-weight: 500; text-decoration: none; box-shadow: 0 2px 8px rgb(0 0 0 / 0.2); }
  .map-link:hover { color: var(--accent); }

  @media (max-width: 800px) {
    .contact { padding-top: 6.5rem; }
    .layout { grid-template-columns: 1fr; }
    .info { padding: 1.5rem; }
    .map { min-height: 320px; }
  }
</style>